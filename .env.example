MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ant_tech_async
MYSQL_USER=
MYSQL_PASSWORD=
API_PORT=8790
QUICKEMAILVERIFICATION_API_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare Turnstile site key; this one is safe for the browser bundle.
VITE_TURNSTILE_SITE_KEY=
# Optional for packaged desktop builds that cannot use a relative /api URL.
VITE_API_BASE_URL=
CONNECT_RATE_WINDOW_MS=60000
CONNECT_ISSUE_LIMIT_PER_USER=80
CONNECT_ISSUE_LIMIT_PER_HOST=50
CONNECT_ATTEMPT_LIMIT_PER_USER=120
CONNECT_ATTEMPT_LIMIT_PER_HOST=80

# --- Email (signup verification and notifications) ---
# Values are read raw: do not wrap them in quotes. Keep this file's real values only in the server's .env.
# Sender shown to recipients.
MAIL_FROM=
# Primary account: the university cPanel mailbox (SSL on 465).
SMTP_PRIMARY_HOST=mail.uinjakarta.id
SMTP_PRIMARY_PORT=465
SMTP_PRIMARY_USER=
SMTP_PRIMARY_PASS=
# Optional fallback, used only when the primary fails temporarily (for example a rate limit).
# SMTP2GO: host mail.smtp2go.com, port 2525 (STARTTLS) or 465 (SSL).
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=2525
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
# Public origin of the web app, used in verification links (dev: http://localhost:5173).
APP_PUBLIC_ORIGIN=
# Messages per UTC day before sending stops and records 'deferred' (default 150, under SMTP2GO's 200).
EMAIL_DAILY_CAP=150
